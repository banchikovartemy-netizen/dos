static int load_image(const u8*d,u32 sz,const char*name){kmemset(mem,0,sizeof(mem));kmemset(&c,0,sizeof(c));c.fl=F_IF|2;c.alloc_seg=0x3000;c.video_mode=3;default_palette();for(int i=0;i<TEXT_W*TEXT_H;i++)c.text[i]=' ';kstrncpy(c.name,name?name:"ПРОГРАММА",sizeof(c.name));c.running=1;set_status("DOS86 // ЗАПУЩЕН");if(sz>=28&&d[0]=='M'&&d[1]=='Z'){u16 last=(u16)(d[2]|d[3]<<8),pages=(u16)(d[4]|d[5]<<8),relocs=(u16)(d[6]|d[7]<<8),hdrp=(u16)(d[8]|d[9]<<8),ss=(u16)(d[14]|d[15]<<8),sp=(u16)(d[16]|d[17]<<8),ip=(u16)(d[20]|d[21]<<8),cs=(u16)(d[22]|d[23]<<8),roff=(u16)(d[24]|d[25]<<8);u32 filebytes=pages?((u32)(pages-1)*512u+(last?last:512)):sz;if(filebytes>sz)filebytes=sz;u32 hbytes=(u32)hdrp*16u;if(hbytes>=filebytes)return 0;u16 load=0x1010;u32 image=filebytes-hbytes;if(lin(load,0)+image>=0x9F000)return 0;kmemcpy(mem+lin(load,0),d+hbytes,image);for(u16 i=0;i<relocs;i++){u32 p=(u32)roff+i*4u;if(p+3>=sz)break;u16 off=(u16)(d[p]|d[p+1]<<8),seg=(u16)(d[p+2]|d[p+3]<<8);u16 a=(u16)(load+seg);mw16(a,off,(u16)(mr16(a,off)+load));}c.cs=(u16)(load+cs);c.ip=ip;c.ss=(u16)(load+ss);c.sp=sp;c.ds=c.es=0x1000;mem[lin(0x1000,0)]=0xCD;mem[lin(0x1000,1)]=0x20;set_status("DOS86 // MZ EXE // РЕАЛЬНЫЙ РЕЖИМ");return 1;}if(sz>0xFE00)return 0;c.cs=c.ds=c.es=c.ss=0x1000;c.ip=0x100;c.sp=0xFFFE;mem[lin(0x1000,0)]=0xCD;mem[lin(0x1000,1)]=0x20;kmemcpy(mem+lin(0x1000,0x100),d,sz);set_status("DOS86 // COM // РЕАЛЬНЫЙ РЕЖИМ");return 1;}
int dos86_start(const u8*d,u32 sz,const char*name){return d&&sz&&load_image(d,sz,name);}
void dos86_stop(void){c.running=0;c.waiting=0;set_status("DOS86 // ОСТАНОВЛЕН");}
int dos86_active(void){return c.running;}
int dos86_step(u32 budget){if(!c.running||c.waiting)return 0;u32 n=0;while(c.running&&!c.waiting&&n++<budget){u16 oldcs=c.cs,oldip=c.ip;if(!step_one()){char s[128]="НЕПОДДЕРЖИВАЕМАЯ КОМАНДА @ ";char q[16];kitoa((i32)oldcs,q);kstrcat(s,q,sizeof(s));kstrcat(s,":",sizeof(s));kitoa((i32)oldip,q);kstrcat(s,q,sizeof(s));set_status(s);c.running=0;break;}c.insns++;}return c.running;}
static u8 scan_for(KeyEvent e){if(e.special==KEY_ESC)return 1;if(e.special==KEY_ENTER)return 0x1C;if(e.special==KEY_BACKSPACE)return 0x0E;if(e.special==KEY_UP)return 0x48;if(e.special==KEY_DOWN)return 0x50;if(e.special==KEY_LEFT)return 0x4B;if(e.special==KEY_RIGHT)return 0x4D;char ch=e.ch;if(ch>='a'&&ch<='z')return (u8)(0x1E+(ch-'a'));return 0;}
void dos86_key(KeyEvent e){if(!e.pressed)return;u8 a=(u8)e.ch;if(e.special==KEY_ENTER)a='\r';else if(e.special==KEY_BACKSPACE)a='\b';else if(e.special==KEY_ESC)a=27;key_push(a,scan_for(e));}
static u32 rgb(u8 i){return((u32)c.pal[i][0]<<16)|((u32)c.pal[i][1]<<8)|c.pal[i][2];}
void dos86_draw(int cx,int cy,int cw,int ch){u8 a=(u8)(vga_fg()|(vga_bg()<<4)),h=(u8)(vga_hi()|(vga_bg()<<4)),d=(u8)(vga_dim()|(vga_bg()<<4));if(c.video_mode==0x13){int planar=!(c.seq[4]&0x08);u16 start=(u16)(((u16)c.crtc[0x0C]<<8)|c.crtc[0x0D]);if(vga_framebuffer()){int x,y,w,hh;vga_cell_rect(cx,cy,cw,ch,&x,&y,&w,&hh);if(w<1||hh<1)return;for(int yy=0;yy<hh;yy++){int sy=yy*200/hh;for(int xx=0;xx<w;xx++){int sx=xx*320/w;u8 px;if(planar){u16 off=(u16)(start+sy*80+(sx>>2));px=c.planes[sx&3][off];}else px=mem[0xA0000+sy*320+sx];vga_pixel(x+xx,y+yy,rgb(px));}}}else{static const char ramp[]=" .:-=+*#%@";for(int yy=0;yy<ch;yy++){int sy=yy*200/ch;for(int xx=0;xx<cw;xx++){int sx=xx*320/cw;u8 px;if(planar){u16 off=(u16)(start+sy*80+(sx>>2));px=c.planes[sx&3][off];}else px=mem[0xA0000+sy*320+sx];vga_put(cx+xx,cy+yy,ramp[(px*9)/255],px?h:d);}}}}else{for(int y=0;y<ch&&y<TEXT_H;y++)for(int x=0;x<cw&&x<TEXT_W;x++){char q=(char)mem[0xB8000+((u32)y*TEXT_W+x)*2];if(!q)q=c.text[y*TEXT_W+x];vga_put(cx+x,cy+y,q?q:' ',a);}}}
const char*dos86_status(void){return c.status;}
const char*dos86_level(void){return "8086/80186 COM+MZ // VGA13/MODEX // ЗВУК SB16";}
int dos86_run(const u8*d,u32 sz,const char*name,char*out,u32 outn){if(!out||outn<2||!dos86_start(d,sz,name))return 0;u32 guard=0;while(c.running&&!c.waiting&&guard<2000){dos86_step(5000);guard++;}kstrncpy(out,c.out,outn);if(c.waiting)kstrcat(out,"\n[DOS86: ОЖИДАНИЕ КЛАВИАТУРЫ]",outn);else if(c.running)kstrcat(out,"\n[DOS86: ЛИМИТ КОМАНД]",outn);else if(c.status[0]&&kstrlen(out)<outn-2){kstrcat(out,"\n[",outn);kstrcat(out,c.status,outn);kstrcat(out,"]",outn);}return 1;}
int dos86_run_com(const u8*d,u32 sz,char*out,u32 outn){return dos86_run(d,sz,"PROGRAM.COM",out,outn);}
